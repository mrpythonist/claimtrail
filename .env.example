# Root environment file for Docker Compose. Copy to .env and adjust.
# Never commit a real .env file.

# Laravel application key. Generate one with:
#   php artisan key:generate --show
# (run inside backend/, or once via docker compose run backend php artisan key:generate --show)
APP_KEY=

# PostgreSQL credentials used by the db service and the backend.
DB_DATABASE=claimtrail
DB_USERNAME=claimtrail
DB_PASSWORD=claimtrail

# API base URL baked into the frontend build.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
