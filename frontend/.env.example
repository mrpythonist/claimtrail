# Base URL of the Laravel API, including the /api/v1 prefix.
# Local development (php artisan serve): http://localhost:8000/api/v1
# Docker Compose: http://localhost:8000/api/v1 (backend published on port 8000)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# Public origin of the marketing site, used for canonical URLs,
# Open Graph, the sitemap, and robots.txt. Leave unset until the
# site has a real domain; the SEO routes omit absolute URLs they
# cannot build honestly.
# NEXT_PUBLIC_SITE_URL=https://claimtrail.example.com

# Marketing-site analytics. Off unless "true". Events go to the
# backend's public analytics endpoint; the default driver writes
# them to the Laravel log. A real provider (GA4, Plausible) needs
# a measurement ID supplied by Aqib.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
